# 复制为 deploy/.env 后按需填写；密钥类只放占位符，禁止提交真实值。
POSTGRES_USER=haochen
POSTGRES_PASSWORD=haochen
POSTGRES_DB=haochen

MINIO_ROOT_USER=haochen
MINIO_ROOT_PASSWORD=haochen-dev-secret

DEVICE_SIM_SIGNING_SECRET=dev-signing-secret

# 开发态身份请求头（X-Dev-Username）：默认关闭；仅在本地联调需要免登录调试时设为 true
DEV_IDENTITY_ENABLED=false

# 门锁主密钥（生产改为密钥管理下发）
LOCK_MASTER_KEY=change-me

# 后台任务 worker 槽位：与 Run 队列分离，长知识任务不占 AgentRun 容量
ARQ_MAX_JOBS=4

# 模型接入：OpenAI 兼容接口；MODEL_API_KEY 留空时先回退系统环境变量 DEEP_SEEK_API_KEY，
# 两者都为空时后端走开发态 stub 模型
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_TEMPERATURE=0.2

# 知识库嵌入：默认走 dev 确定性实现。启用本地 BGE 时先运行
#   python deploy/prepare_bge_models.py
# 再启动 `docker compose --profile knowledge up -d bge-embed`，并取消下面注释。
# 模型名与维度必须匹配；换 provider 会生成新 Milvus 集合，需要全量重建索引。
# MODEL_EMBEDDING_NAME=bge-m3
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=http://bge-embed:80/v1
# EMBEDDING_API_KEY=

# 本地 BGE 重排：CPU 实测 23 个真实分块需 53-59s，默认关闭；
# 仅在 GPU 或更小模型验证通过后，用 `--profile bge-rerank` 启动并设置 RERANK_BASE_URL。
KB_RERANK_ENABLED=false
# RERANK_BASE_URL=http://bge-rerank:80
# RERANK_API_KEY=
# RERANK_MODEL_NAME=bge-reranker-v2-m3

# 关系图补充腿：命中房型设施/周边结构化问题才查 Neo4j；图不可用时自动降级
KB_GRAPH_ENABLED=true
KB_GRAPH_TIMEOUT_SECONDS=3

# BGE 模型目录（宿主机，相对 deploy/）：默认由 prepare_bge_models.py 写入 ./models
# BGE_MODELS_DIR=./models

# 微信支付（P4 接入后启用）
WECHAT_PAY_MCHID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL=

# 订阅消息模板（密码与入住指引第二通道）：留空 = 不下发，仅记 credential_notified(skipped) 事件
WECHAT_SUBSCRIBE_TEMPLATE_ID=

# ── 可观测与告警（P4.3）──
# Langfuse 默认按外部托管处理：只填密钥不会外发。二选一：
#   1) 自建：LANGFUSE_SELF_HOSTED=true，LANGFUSE_BASE_URL 指向内网地址；
#   2) 外发：LANGFUSE_ALLOW_EXTERNAL_EXPORT=true，用户/会话标识经 SHA-256 脱敏，
#      score 的自由文本备注一律丢弃。生产环境两项都未声明时拒绝启动。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_SELF_HOSTED=false
LANGFUSE_ALLOW_EXTERNAL_EXPORT=false
# 告警阈值（GET /api/admin/health/alerts 只读事实按阈值判定）
# ALERT_PENDING_STUCK_SECONDS=300
# ALERT_RUNNING_STUCK_SECONDS=180
# ALERT_LEASE_WINDOW_MINUTES=15
# ALERT_LEASE_EXPIRY_RATE=0.05
# ALERT_LEASE_MIN_ATTEMPTS=10
# ALERT_SSE_WINDOW_MINUTES=15
# ALERT_SSE_DISCONNECT_RATE=0.1
# ALERT_SSE_MIN_STREAMS=20
# ALERT_DB_POOL_USAGE=0.9

# ── 备份与合规（P4.5）──
# 备份容器每天执行一次；本地保留 30 天。生产必须配置加密密钥与异地目录（prod 覆盖层强制）。
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
# BACKUP_ENCRYPTION_KEY=          # 生产必填，经密钥管理下发；仅通过环境变量注入
# OFFSITE_BACKUP_DIR=/mnt/offsite # 生产必填，必须是不同故障域
# BACKUP_REQUIRE_ENCRYPTION=true
# BACKUP_REQUIRE_OFFSITE=true

# 隐私告知版本：客人同意记录必须与该版本一致
PRIVACY_POLICY_VERSION=2026-10-18

# ── 生产覆盖层（docker-compose.prod.yml）必填，生产部署前逐项替换 ──
# ENV=production 由覆盖层注入；下面各项在生产环境缺省即拒绝启动（或 compose 直接报错）。
# POSTGRES_PASSWORD=<强口令>
# MINIO_ROOT_PASSWORD=<强口令>
# NEO4J_PASSWORD=<强口令>
# LOCK_MASTER_KEY=<至少 16 字符的随机密钥>
# DEVICE_SIM_SIGNING_SECRET=<强口令>
# CORS_ORIGINS=["https://admin.example.com"]
# SERVER_NAME=hotel.example.com
# TLS 证书放置：deploy/nginx/certs/fullchain.pem 与 privkey.pem
