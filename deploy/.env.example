# 复制为 deploy/.env 后按需填写；密钥类只放占位符，禁止提交真实值。
POSTGRES_USER=haochen
POSTGRES_PASSWORD=haochen
POSTGRES_DB=haochen

MINIO_ROOT_USER=haochen
MINIO_ROOT_PASSWORD=haochen-dev-secret

DEVICE_SIM_SIGNING_SECRET=dev-signing-secret

# 开发态身份请求头（X-Dev-Username）：默认关闭；仅在本地联调需要免登录调试时设为 true
DEV_IDENTITY_ENABLED=false

# 门锁主密钥（生产改为密钥管理下发）
LOCK_MASTER_KEY=change-me

# 后台任务 worker 槽位：与 Run 队列分离，长知识任务不占 AgentRun 容量
ARQ_MAX_JOBS=4

# 模型接入：OpenAI 兼容接口；MODEL_API_KEY 留空时先回退系统环境变量 DEEP_SEEK_API_KEY，
# 两者都为空时后端走开发态 stub 模型
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_TEMPERATURE=0.2

# 知识库嵌入：默认走 dev 确定性实现。启用本地 BGE 时先运行
#   python deploy/prepare_bge_models.py
# 再启动 `docker compose --profile knowledge up -d bge-embed`，并取消下面注释。
# 模型名与维度必须匹配；换 provider 会生成新 Milvus 集合，需要全量重建索引。
# MODEL_EMBEDDING_NAME=bge-m3
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=http://bge-embed:80/v1
# EMBEDDING_API_KEY=

# 本地 BGE 重排：CPU 实测 23 个真实分块需 53-59s，默认关闭；
# 仅在 GPU 或更小模型验证通过后，用 `--profile bge-rerank` 启动并设置 RERANK_BASE_URL。
KB_RERANK_ENABLED=false
# RERANK_BASE_URL=http://bge-rerank:80
# RERANK_API_KEY=
# RERANK_MODEL_NAME=bge-reranker-v2-m3

# 关系图补充腿：命中房型设施/周边结构化问题才查 Neo4j；图不可用时自动降级
KB_GRAPH_ENABLED=true
KB_GRAPH_TIMEOUT_SECONDS=3

# BGE 模型目录（宿主机，相对 deploy/）：默认由 prepare_bge_models.py 写入 ./models
# BGE_MODELS_DIR=./models

# 微信支付（P4 接入后启用）
WECHAT_PAY_MCHID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL=

# 订阅消息模板（密码与入住指引第二通道）：留空 = 不下发，仅记 credential_notified(skipped) 事件
WECHAT_SUBSCRIBE_TEMPLATE_ID=
